# =============================================================================
# Dockerfile.gpu — ambiente FLIM AL com suporte à RTX 50xx (sm_120 / Blackwell)
#
# Por que uma imagem nova
#   A flim-ad-env é Ubuntu 18.04 (glibc 2.27). Os wheels PyTorch cu128, que são
#   os primeiros com kernels sm_120, exigem glibc >= 2.28 (tag manylinux_2_28).
#   Não há flag de pip que contorne isso. Esta base é Ubuntu 22.04 (glibc 2.35)
#   e já traz torch 2.7.0+cu128 com sm_120 compilado.
#
# Versões fixadas
#   Todas casam com o ambiente que produziu os resultados atuais, para que a
#   troca de imagem não mude os números:
#     numpy  1.26.4  — scikit-image 0.22 exige numpy < 2 (a base traz 2.2.5)
#     scipy  1.11.4  — pyflim usa scipy.ndimage.morphology, removido em 1.15
#     sklearn 1.3.2, scikit-image 0.22.0, monai 1.5.2, pillow 9.3.0
#
#   faiss NÃO é instalado de propósito. Na imagem antiga ele está quebrado
#   (erro de binding SWIG) e o pyflim cai no fallback de KMeans do sklearn —
#   que foi o caminho usado para gerar todos os resultados existentes.
#   Instalar um faiss funcional mudaria o treino do encoder e tornaria os
#   novos números incomparáveis com os antigos.
#
# BUILD (do host, na raiz do repo):
#   docker build -f Dockerfile.gpu -t flim-ad-env:gpu .
#
# RUN:
#   docker run --gpus all -it \
#     -v "C:\Users\galet\OneDrive\Desktop\github\Flim2\flim-python-demo:/workspace/flim-python-demo" \
#     -w /workspace/flim-python-demo flim-ad-env:gpu bash
#
# O código e os dados vêm do bind mount — a imagem só carrega dependências.
# =============================================================================

FROM pytorch/pytorch:2.7.0-cuda12.8-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1

# libGL/libglib: scikit-image e matplotlib precisam em runtime headless
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# numpy primeiro e fixado: instalar depois deixaria o resolvedor puxar 2.x
RUN pip install --no-cache-dir "numpy==1.26.4"

RUN pip install --no-cache-dir \
        "scipy==1.11.4" \
        "scikit-learn==1.3.2" \
        "scikit-image==0.22.0" \
        "monai==1.5.2" \
        "pillow==9.3.0" \
        "matplotlib==3.8.4"

# transformers: pyflim/flim.py importa get_cosine_schedule_with_warmup no topo,
# SEM try/except — sem ele o unpickle dos encoders salvos falha. É a única
# coisa que o pacote fornece aqui. --no-deps evita que ele arraste sua própria
# versão de torch/numpy por cima das que fixamos acima.
RUN pip install --no-cache-dir --no-deps "transformers==4.44.2" \
    && pip install --no-cache-dir \
        "tokenizers<0.20" "huggingface-hub<1.0" "safetensors" \
        "regex" "requests" "pyyaml" "tqdm" "packaging" "filelock"

# Falha o build se o resolvedor tiver trocado numpy/scipy por baixo dos panos,
# ou se a GPU não tiver kernel para esta arquitetura.
RUN python - <<'EOF'
import numpy, scipy, sklearn, skimage, monai, PIL, torch, torchvision
assert numpy.__version__.startswith("1.26"), f"numpy trocado: {numpy.__version__}"
assert scipy.__version__.startswith("1.11"), f"scipy trocado: {scipy.__version__}"
assert torch.__version__.startswith("2.7"), f"torch trocado: {torch.__version__}"
from scipy.ndimage.morphology import distance_transform_edt  # noqa: F401
from transformers import get_cosine_schedule_with_warmup     # noqa: F401
print("deps OK:",
      "numpy", numpy.__version__, "| scipy", scipy.__version__,
      "| sklearn", sklearn.__version__, "| skimage", skimage.__version__,
      "| monai", monai.__version__, "| pillow", PIL.__version__,
      "| torch", torch.__version__, "| torchvision", torchvision.__version__)
EOF

WORKDIR /workspace/flim-python-demo
CMD ["bash"]
